# Copy to .env and fill in. Nothing here is required to run SkyPanel with a
# local receiver and adsbdb enrichment -- every value is optional.

# FlightAware AeroAPI v4 key. Leave unset to stay on adsbdb only.
# Feeders get $10/month of query fees free; the backend enforces a hard monthly
# ceiling (enrich.aeroapi_monthly_limit in config.toml) and degrades to adsbdb
# when it is reached.
AEROAPI_KEY=

# Where the backend keeps its cache, settings and history. Defaults to
# ~/.local/state/skypanel.
# SKYPANEL_STATE_DIR=/var/lib/skypanel

# Path to config.toml. Defaults to ./config.toml.
# SKYPANEL_CONFIG=/etc/skypanel/config.toml
