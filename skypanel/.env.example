# Copy to .env and fill in. Never commit .env.

# FlightAware AeroAPI v4 key. Optional — leave unset and enrichment uses adsbdb only.
# Feeders get $10/month of query fees free; the backend enforces
# [enrich].aeroapi_monthly_limit on top of that and degrades to adsbdb when it's hit.
AEROAPI_KEY=

# Overrides for config.toml, useful in containers.
# SKYPANEL_SOURCE_MODE=local
# SKYPANEL_LOCAL_HOST=raspberrypi.local
# SKYPANEL_AGGREGATOR=adsb_fi
# SKYPANEL_HOST=0.0.0.0
# SKYPANEL_PORT=8000
# SKYPANEL_STATE_DIR=/var/lib/skypanel
# SKYPANEL_CONFIG=/etc/skypanel/config.toml
